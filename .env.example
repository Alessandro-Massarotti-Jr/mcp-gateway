# ---------------------------------------------------------------------------
# Gateway
# ---------------------------------------------------------------------------
# HTTP port exposed by the container.
PORT=4000
# Listening interface. Inside Docker it has to be 0.0.0.0.
HOST=0.0.0.0
# Prefix of EVERY tool: {GATEWAY_NAME}_{PROVIDER}_{OPERATION}.
# It is normalized to uppercase with underscores (e.g. "my gateway" -> MY_GATEWAY).
GATEWAY_NAME=MCP_GATEWAY
# Path of the MCP endpoint (Streamable HTTP).
MCP_PATH=/mcp
# debug | info | warn | error | silent
LOG_LEVEL=info
# Maximum body size of MCP requests.
REQUEST_BODY_LIMIT=4mb

# ---------------------------------------------------------------------------
# PostgreSQL — optional. Without this URL, no _POSTGRES_ tool is exposed.
# ---------------------------------------------------------------------------
POSTGRES_CONNECTION_URL=postgres://user:password@postgres:5432/my_database
POSTGRES_POOL_MAX=10
POSTGRES_CONNECTION_TIMEOUT_MS=10000
POSTGRES_STATEMENT_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# MongoDB — optional. Works with a self-hosted instance and with Atlas.
# Atlas: mongodb+srv://user:password@cluster0.abc.mongodb.net/my_database
# ---------------------------------------------------------------------------
MONGO_CONNECTION_URL=mongodb://user:password@mongo:27017/my_database?authSource=admin
# Database used when the tool receives no "database". If empty, falls back to the URL's database.
MONGO_DEFAULT_DATABASE=
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_MAX_POOL_SIZE=10

# ---------------------------------------------------------------------------
# RabbitMQ — optional. The gateway only publishes and queries: it never
# declares, changes or removes queues, exchanges, bindings or users.
# ---------------------------------------------------------------------------
RABBITMQ_CONNECTION_URL=amqp://user:password@rabbitmq:5672
RABBITMQ_CONNECTION_TIMEOUT_MS=10000
RABBITMQ_PUBLISH_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Redis — optional. The gateway reads keys and writes plain strings: it never
# flushes a database, changes the configuration or runs arbitrary commands.
# The path selects the logical database (redis://host:6379/2); use rediss:// for TLS.
# ---------------------------------------------------------------------------
REDIS_CONNECTION_URL=redis://localhost:6379/0
REDIS_CONNECTION_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Oracle — optional. oracle://user:password@host:port/service_name, turned into
# an Easy Connect string; anything after "?" goes along (e.g. ?ssl_server_dn_match=true).
# Percent-encode special characters of the password (@ -> %40).
# Like PostgreSQL, it only changes data: DDL and PL/SQL execution are refused.
# ---------------------------------------------------------------------------
ORACLE_CONNECTION_URL=oracle://app:app@localhost:1521/FREEPDB1
ORACLE_POOL_MAX=10
ORACLE_CONNECTION_TIMEOUT_MS=10000
ORACLE_STATEMENT_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Result limits applied to the read tools
# ---------------------------------------------------------------------------
# Rows/documents returned when the call provides no limit.
DEFAULT_ROW_LIMIT=100
# Cap the call is allowed to ask for.
MAX_ROW_LIMIT=1000

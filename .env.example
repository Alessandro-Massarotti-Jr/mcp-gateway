# ---------------------------------------------------------------------------
# Gateway
# ---------------------------------------------------------------------------
# Porta HTTP exposta pelo container.
PORT=4000
# Interface de escuta. Dentro do Docker precisa ser 0.0.0.0.
HOST=0.0.0.0
# Prefixo de TODAS as tools: {GATEWAY_NAME}_{PROVIDER}_{OPERACAO}.
# É normalizado para maiúsculas com underscore (ex.: "meu gateway" -> MEU_GATEWAY).
GATEWAY_NAME=MCP_GATEWAY
# Caminho do endpoint MCP (Streamable HTTP).
MCP_PATH=/mcp
# debug | info | warn | error | silent
LOG_LEVEL=info
# Tamanho máximo do corpo das requisições MCP.
REQUEST_BODY_LIMIT=4mb

# ---------------------------------------------------------------------------
# PostgreSQL — opcional. Sem esta URL, nenhuma tool _POSTGRES_ é exposta.
# ---------------------------------------------------------------------------
POSTGRES_CONNECTION_URL=postgres://usuario:senha@postgres:5432/meu_banco
POSTGRES_POOL_MAX=10
POSTGRES_CONNECTION_TIMEOUT_MS=10000
POSTGRES_STATEMENT_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# MongoDB — opcional. Funciona com instância própria e com o Atlas.
# Atlas: mongodb+srv://usuario:senha@cluster0.abc.mongodb.net/meu_banco
# ---------------------------------------------------------------------------
MONGO_CONNECTION_URL=mongodb://usuario:senha@mongo:27017/meu_banco?authSource=admin
# Banco usado quando a tool não recebe "database". Se vazio, cai no banco da URL.
MONGO_DEFAULT_DATABASE=
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_MAX_POOL_SIZE=10

# ---------------------------------------------------------------------------
# RabbitMQ — opcional. O gateway só publica e consulta: nunca declara,
# altera ou remove filas, exchanges, bindings ou usuários.
# ---------------------------------------------------------------------------
RABBITMQ_CONNECTION_URL=amqp://usuario:senha@rabbitmq:5672
RABBITMQ_CONNECTION_TIMEOUT_MS=10000
RABBITMQ_PUBLISH_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Limites de resultado aplicados às tools de leitura
# ---------------------------------------------------------------------------
# Linhas/documentos devolvidos quando a chamada não informa limite.
DEFAULT_ROW_LIMIT=100
# Teto que a chamada pode pedir.
MAX_ROW_LIMIT=1000

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "[Bb]ash|[Pp]ower[Ss]hell|[Ss]hell|[Cc]md|[Tt]erminal|run_command|execute_command|exec_command",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "guard-commands",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-commands/guard-commands.mjs",
              "--deny=git push,git reset --hard,git checkout -f,git clean -f,git branch -D,git filter-branch,git stash drop,git stash clear,git update-ref -d,git reflog delete,rm -rf,Remove-Item -Recurse -Force,npm publish",
              "--allow=git push --dry-run"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "[Ww]rite|[Ee]dit|[Nn]otebook|[Bb]ash|[Pp]ower[Ss]hell|[Ss]hell|[Cc]md|[Tt]erminal|apply_patch|create_file|str_replace",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "protect-files",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-files/protect-files.mjs",
              "--paths=.eslintrc*,eslint.config.*,.eslintignore,jest.config.*,jest.setup.*,.prettierrc*,prettier.config.*,.prettierignore,tsconfig.json,tsconfig.*.json",
              "--allow=",
              "--message="
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "mask-env",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/mask-env/mask-env.mjs",
              "--allow=.env.example",
              "--placeholder=<censurado>"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "verify-changes: baseline",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/verify-changes/verify-changes.mjs",
              "--event=sessionStart",
              "--paths=src"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "verify-changes: format, lint, build, test",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/verify-changes/verify-changes.mjs",
              "--event=agentStop",
              "--paths=src",
              "--format=format",
              "--commands=lint,build,test",
              "--max-attempts=3",
              "--budget-sec=900",
              "--command-timeout-sec=300",
              "--max-blocks=6",
              "--notify=always"
            ],
            "timeout": 960
          }
        ]
      }
    ]
  }
}
